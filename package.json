{
  "name": "the-last-call",
  "version": "1.0.0",
  "private": true,
  "description": "Production-ready Telegram social deduction game backend.",
  "type": "module",
  "engines": {"node": ">=20"},
  "scripts": {
    "dev": "tsx src/server/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/server/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "backup": "tsx scripts/backup.ts",
    "restore": "tsx scripts/restore.ts",
    "seed": "tsx scripts/seed.ts"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^17.2.2",
    "express": "^5.1.0",
    "grammy": "^1.38.4",
    "helmet": "^8.1.0",
    "ioredis": "^5.7.0",
    "pino": "^9.9.0",
    "prom-client": "^15.1.3",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^24.3.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
